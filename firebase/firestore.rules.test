rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() {
      return request.auth != null;
    }

    function role() {
      return authenticated()
        ? request.auth.token.rol
        : null;
    }

    function canOperate() {
      return role() in [
        'supervisor',
        'jefe',
        'gerencia'
      ];
    }

    function canManage() {
      return role() in [
        'jefe',
        'gerencia'
      ];
    }

    function belongsToCompany(data) {
      return authenticated() &&
        data.empresa_id ==
          request.auth.token.empresa_id;
    }

    function plantIds() {
      return authenticated() &&
        request.auth.token.planta_ids is list
          ? request.auth.token.planta_ids
          : [];
    }

    function belongsToPlant(data) {
      return belongsToCompany(data) &&
        (
          role() == 'gerencia' ||
          data.planta_id in plantIds()
        );
    }

    function legacyCollection(collectionName) {
      return collectionName in [
        'ajustes_produccion',
        'config_procesos',
        'config_productos',
        'estandares',
        'operaciones_maestras',
        'operarios',
        'paros_produccion',
        'procesos',
        'produccion_activa',
        'registros_produccion',
        'subprocesos',
        'usuarios'
      ];
    }

    match /materiales/{materialId} {
      allow read: if belongsToCompany(
        resource.data
      );
      allow create: if canManage() &&
        belongsToCompany(
          request.resource.data
        );
      allow update: if canManage() &&
        belongsToCompany(resource.data) &&
        belongsToCompany(
          request.resource.data
        ) &&
        request.resource.data.empresa_id ==
          resource.data.empresa_id &&
        request.resource.data.diff(
          resource.data
        ).affectedKeys().hasOnly([
          'activo',
          'actualizado_en'
        ]);
      allow delete: if false;
    }

    match /productos/{productoId} {
      allow read: if belongsToCompany(
        resource.data
      );
      allow create: if canManage() &&
        belongsToCompany(
          request.resource.data
        );
      allow update: if canManage() &&
        belongsToCompany(resource.data) &&
        belongsToCompany(
          request.resource.data
        ) &&
        request.resource.data.diff(
          resource.data
        ).affectedKeys().hasOnly([
          'activo',
          'version_ruta_activa',
          'fecha_actualizacion'
        ]);
      allow delete: if false;

      match /rutas/{rutaId} {
        allow read: if belongsToCompany(
          resource.data
        );
        allow create: if canManage() &&
          belongsToCompany(
            request.resource.data
          );
        allow update: if canManage() &&
          belongsToCompany(resource.data) &&
          belongsToCompany(
            request.resource.data
          ) &&
          request.resource.data.diff(
            resource.data
          ).affectedKeys().hasOnly([
            'estado',
            'vigente_desde',
            'fecha_actualizacion'
          ]);
        allow delete: if false;

        match /operaciones/{operacionId} {
          allow read: if belongsToCompany(
            resource.data
          );
          allow create: if canManage() &&
            belongsToCompany(
              request.resource.data
            );
          allow update, delete: if false;
        }
      }
    }

    match /correlativos/{correlativoId} {
      allow read: if canManage();
      allow create: if canManage() &&
        belongsToPlant(
          request.resource.data
        );
      allow update: if canManage() &&
        belongsToPlant(resource.data) &&
        belongsToPlant(
          request.resource.data
        ) &&
        request.resource.data.empresa_id ==
          resource.data.empresa_id &&
        request.resource.data.planta_id ==
          resource.data.planta_id &&
        request.resource.data.ultimo ==
          resource.data.ultimo + 1;
      allow delete: if false;
    }

    match /ordenes_trabajo/{otId} {
      allow read: if
        resource.data.modelo_version != 2 &&
        authenticated();
      allow read: if
        resource.data.modelo_version == 2 &&
        belongsToPlant(resource.data);

      allow create: if
        request.resource.data.modelo_version != 2 &&
        canOperate();
      allow create: if
        request.resource.data.modelo_version == 2 &&
        canManage() &&
        belongsToPlant(
          request.resource.data
        );

      allow update: if
        resource.data.modelo_version != 2 &&
        canOperate();
      allow update: if
        resource.data.modelo_version == 2 &&
        canOperate() &&
        belongsToPlant(resource.data) &&
        belongsToPlant(
          request.resource.data
        ) &&
        request.resource.data.empresa_id ==
          resource.data.empresa_id &&
        request.resource.data.planta_id ==
          resource.data.planta_id &&
        request.resource.data.diff(
          resource.data
        ).affectedKeys().hasOnly([
          'estado',
          'avance_pct',
          'fecha_real_inicio',
          'fecha_real_fin',
          'fecha_actualizacion'
        ]);
      allow delete: if
        resource.data.modelo_version != 2 &&
        canManage();

      match /operaciones/{operacionId} {
        allow read: if belongsToPlant(
          resource.data
        );
        allow create: if canManage() &&
          belongsToPlant(
            request.resource.data
          );
        allow update: if canOperate() &&
          belongsToPlant(resource.data) &&
          belongsToPlant(
            request.resource.data
          ) &&
          request.resource.data.empresa_id ==
            resource.data.empresa_id &&
          request.resource.data.planta_id ==
            resource.data.planta_id &&
          request.resource.data.diff(
            resource.data
          ).affectedKeys().hasOnly([
            'cantidad_ok',
            'cantidad_defectuosa',
            'cantidad_reproceso',
            'cantidad_consumida',
            'cantidad_pendiente',
            'avance_pct',
            'estado',
            'fecha_inicio',
            'fecha_fin',
            'fecha_actualizacion'
          ]);
        allow delete: if false;
      }
    }

    match /sesiones_produccion/{sesionId} {
      allow read: if belongsToPlant(resource.data);
      allow create: if canOperate() &&
        belongsToPlant(
          request.resource.data
        ) &&
        request.resource.data.supervisor_id ==
          request.auth.uid;
      allow update: if canOperate() &&
        belongsToPlant(resource.data) &&
        belongsToPlant(
          request.resource.data
        ) &&
        request.resource.data.diff(
          resource.data
        ).affectedKeys().hasOnly([
          'estado',
          'fin',
          'tiempo_productivo_seg',
          'tiempo_paro_seg',
          'cantidad_ok',
          'cantidad_defectuosa',
          'cantidad_reproceso',
          'produccion_total',
          'produccion_esperada',
          'rendimiento_pct',
          'calidad_pct',
          'eficiencia_calidad_pct'
        ]);
      allow delete: if false;
    }

    match /eventos_produccion/{eventoId} {
      allow read: if belongsToPlant(resource.data);
      allow create: if canOperate() &&
        belongsToPlant(
          request.resource.data
        ) &&
        request.resource.data.registrado_por_id ==
          request.auth.uid;
      allow update, delete: if false;
    }

    match /{collectionName}/{documentId} {
      allow read: if authenticated() &&
        legacyCollection(collectionName);
      allow create, update: if canOperate() &&
        legacyCollection(collectionName);
      allow delete: if canManage() &&
        legacyCollection(collectionName);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
