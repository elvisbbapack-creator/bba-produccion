rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function authenticated() {
      return request.auth != null;
    }

    function role() {
      return authenticated()
        ? request.auth.token.rol
        : null;
    }

    function canOperate() {
      return role() in [
        'supervisor',
        'jefe',
        'gerencia'
      ];
    }

    function canManage() {
      return role() in [
        'jefe',
        'gerencia'
      ];
    }

    function belongsToCompany(data) {
      return authenticated() &&
        data.empresa_id ==
          request.auth.token.empresa_id;
    }

    function plantIds() {
      return authenticated() &&
        request.auth.token.planta_ids is list
          ? request.auth.token.planta_ids
          : [];
    }

    function belongsToPlant(data) {
      return belongsToCompany(data) &&
        (
          role() == 'gerencia' ||
          data.planta_id in plantIds()
        );
    }

    function legacyCollection(collectionName) {
      return collectionName in [
        'ajustes_produccion',
        'config_procesos',
        'config_productos',
        'estandares',
        'operaciones_maestras',
        'operarios',
        'paros_produccion',
        'procesos',
        'produccion_activa',
        'registros_produccion',
        'subprocesos',
        'usuarios'
      ];
    }

    match /materiales/{materialId} {
      allow read: if belongsToCompany(
        resource.data
      );
      allow create: if canManage() &&
        belongsToCompany(
          request.resource.data
        );
      allow update: if canManage() &&
        belongsToCompany(resource.data) &&
        belongsToCompany(
          request.resource.data
        ) &&
        request.resource.data.empresa_id ==
          resource.data.empresa_id &&
        request.resource.data.diff(
          resource.data
        ).affectedKeys().hasOnly([
          'activo',
          'actualizado_en'
        ]);
      allow delete: if false;
    }

    match /{catalogo}/{registroId} {
      allow read: if catalogo in [
          'catalogo_defectos',
          'catalogo_causas',
          'catalogo_motivos_paro'
        ] &&
        belongsToCompany(resource.data);
      allow create: if catalogo in [
          'catalogo_defectos',
          'catalogo_causas',
          'catalogo_motivos_paro'
        ] &&
        canManage() &&
        belongsToCompany(
          request.resource.data
        );
      allow update: if catalogo in [
          'catalogo_defectos',
          'catalogo_causas',
          'catalogo_motivos_paro'
        ] &&
        canManage() &&
        belongsToCompany(resource.data) &&
        belongsToCompany(
          request.resource.data
        ) &&
        request.resource.data.empresa_id ==
          resource.data.empresa_id;
      allow delete: if false;
    }

    match /configuracion_capacidad/{configId} {
      allow get: if canManage() &&
        (
          !exists(
            /databases/$(database)/documents/configuracion_capacidad/$(configId)
          ) ||
          belongsToPlant(resource.data)
        );
      allow create: if canManage() &&
        belongsToPlant(
          request.resource.data
        );
      allow update: if canManage() &&
        belongsToPlant(resource.data) &&
        belongsToPlant(
          request.resource.data
        ) &&
        request.resource.data.empresa_id ==
          resource.data.empresa_id &&
        request.resource.data.planta_id ==
          resource.data.planta_id;
      allow list, delete: if false;
    }

    match /capacidad_procesos/{capacidadId} {
      allow read: if belongsToPlant(resource.data);
      allow create: if canManage() &&
        belongsToPlant(
          request.resource.data
        ) &&
        request.resource.data.actualizado_por_id ==
          request.auth.uid;
      allow update: if canManage() &&
        belongsToPlant(resource.data) &&
        belongsToPlant(
          request.resource.data
        ) &&
        request.resource.data.empresa_id ==
          resource.data.empresa_id &&
        request.resource.data.planta_id ==
          resource.data.planta_id &&
        request.resource.data.subproceso_id ==
          resource.data.subproceso_id &&
        request.resource.data.actualizado_por_id ==
          request.auth.uid;
      allow delete: if false;
    }

    match /programacion_turnos/{programacionId} {
      allow read: if belongsToPlant(resource.data);
      allow create: if canManage() &&
        belongsToPlant(
          request.resource.data
        ) &&
        request.resource.data.actualizado_por_id ==
          request.auth.uid;
      allow update: if canManage() &&
        belongsToPlant(resource.data) &&
        belongsToPlant(
          request.resource.data
        ) &&
        request.resource.data.empresa_id ==
          resource.data.empresa_id &&
        request.resource.data.planta_id ==
          resource.data.planta_id &&
        request.resource.data.semana_inicio ==
          resource.data.semana_inicio &&
        request.resource.data.operario_id ==
          resource.data.operario_id &&
        request.resource.data.actualizado_por_id ==
          request.auth.uid;
      allow delete: if false;
    }

    match /productos/{productoId} {
      allow read: if belongsToCompany(
        resource.data
      );
      allow create: if canManage() &&
        belongsToCompany(
          request.resource.data
        );
      allow update: if canManage() &&
        belongsToCompany(resource.data) &&
        belongsToCompany(
          request.resource.data
        ) &&
        request.resource.data.diff(
          resource.data
        ).affectedKeys().hasOnly([
          'activo',
          'version_ruta_activa',
          'fecha_actualizacion'
        ]);
      allow delete: if false;

      match /rutas/{rutaId} {
        allow read: if belongsToCompany(
          resource.data
        );
        allow create: if canManage() &&
          belongsToCompany(
            request.resource.data
          );
        allow update: if canManage() &&
          belongsToCompany(resource.data) &&
          belongsToCompany(
            request.resource.data
          ) &&
          request.resource.data.diff(
            resource.data
          ).affectedKeys().hasOnly([
            'estado',
            'vigente_desde',
            'fecha_actualizacion'
          ]);
        allow delete: if false;

        match /operaciones/{operacionId} {
          allow read: if belongsToCompany(
            resource.data
          );
          allow create: if canManage() &&
            belongsToCompany(
              request.resource.data
            );
          allow update, delete: if false;
        }
      }
    }

    match /correlativos/{correlativoId} {
      allow read: if canManage();
      allow create: if canManage() &&
        belongsToPlant(
          request.resource.data
        );
      allow update: if canManage() &&
        belongsToPlant(resource.data) &&
        belongsToPlant(
          request.resource.data
        ) &&
        request.resource.data.empresa_id ==
          resource.data.empresa_id &&
        request.resource.data.planta_id ==
          resource.data.planta_id &&
        request.resource.data.ultimo ==
          resource.data.ultimo + 1;
      allow delete: if false;
    }

    match /ordenes_trabajo/{otId} {
      allow read: if
        resource.data.modelo_version != 2 &&
        authenticated();
      allow read: if
        resource.data.modelo_version == 2 &&
        belongsToPlant(resource.data);

      allow create: if
        request.resource.data.modelo_version != 2 &&
        canOperate();
      allow create: if
        request.resource.data.modelo_version == 2 &&
        canManage() &&
        belongsToPlant(
          request.resource.data
        );

      allow update: if
        resource.data.modelo_version != 2 &&
        canOperate();
      allow update: if
        resource.data.modelo_version == 2 &&
        canOperate() &&
        belongsToPlant(resource.data) &&
        belongsToPlant(
          request.resource.data
        ) &&
        request.resource.data.empresa_id ==
          resource.data.empresa_id &&
        request.resource.data.planta_id ==
          resource.data.planta_id &&
        request.resource.data.diff(
          resource.data
        ).affectedKeys().hasOnly([
          'estado',
          'avance_pct',
          'cantidad_total_requerida',
          'cantidad_total_ok',
          'cantidad_total_pendiente',
          'estimado_horas_restantes',
          'fecha_estimada_fin',
          'fecha_real_inicio',
          'fecha_real_fin',
          'merma_total',
          'reprocesos_pendientes',
          'fecha_actualizacion'
        ]);
      allow delete: if
        resource.data.modelo_version != 2 &&
        canManage();

      match /operaciones/{operacionId} {
        allow read: if belongsToPlant(
          resource.data
        );
        allow create: if canManage() &&
          belongsToPlant(
            request.resource.data
          );
        allow update: if canOperate() &&
          belongsToPlant(resource.data) &&
          belongsToPlant(
            request.resource.data
          ) &&
          request.resource.data.empresa_id ==
            resource.data.empresa_id &&
          request.resource.data.planta_id ==
            resource.data.planta_id &&
          request.resource.data.diff(
            resource.data
          ).affectedKeys().hasOnly([
            'cantidad_ok',
            'cantidad_defectuosa',
            'cantidad_reproceso',
            'cantidad_merma',
            'reproceso_pendiente',
            'cantidad_consumida',
            'cantidad_pendiente',
            'avance_pct',
            'estado',
            'fecha_inicio',
            'fecha_fin',
            'fecha_actualizacion'
          ]);
        allow update: if canManage() &&
          belongsToPlant(resource.data) &&
          belongsToPlant(
            request.resource.data
          ) &&
          request.resource.data.diff(
            resource.data
          ).affectedKeys().hasOnly([
            'unidades_por_hora',
            'estandar_estado',
            'estandar_anterior',
            'estandar_motivo',
            'estandar_actualizado_por',
            'estandar_actualizado_en',
            'fecha_actualizacion'
          ]);
        allow delete: if false;
      }
    }

    match /sesiones_produccion/{sesionId} {
      allow read: if belongsToPlant(resource.data);
      allow create: if canOperate() &&
        belongsToPlant(
          request.resource.data
        ) &&
        request.resource.data.supervisor_id ==
          request.auth.uid;
      allow update: if canOperate() &&
        belongsToPlant(resource.data) &&
        belongsToPlant(
          request.resource.data
        ) &&
        request.resource.data.diff(
          resource.data
        ).affectedKeys().hasOnly([
          'estado',
          'fin',
          'tiempo_productivo_seg',
          'tiempo_paro_seg',
          'tiempo_paro_descontable_seg',
          'tiempo_total_seg',
          'paro_inicio',
          'motivo_paro_id',
          'motivo_paro_codigo',
          'motivo_paro_nombre',
          'paro_afecta_eficiencia',
          'cantidad_ok',
          'cantidad_defectuosa',
          'cantidad_reproceso',
          'produccion_total',
          'produccion_esperada',
          'rendimiento_pct',
          'calidad_pct',
          'eficiencia_calidad_pct',
          'evaluar_eficiencia'
        ]);
      allow delete: if false;
    }

    match /eventos_produccion/{eventoId} {
      allow read: if belongsToPlant(resource.data);
      allow create: if canOperate() &&
        belongsToPlant(
          request.resource.data
        ) &&
        request.resource.data.registrado_por_id ==
          request.auth.uid;
      allow update, delete: if false;
    }

    match /registros_calidad/{registroId} {
      allow read: if belongsToPlant(resource.data);
      allow create: if canOperate() &&
        belongsToPlant(
          request.resource.data
        ) &&
        request.resource.data.registrado_por_id ==
          request.auth.uid;
      allow update: if canManage() &&
        belongsToPlant(resource.data) &&
        belongsToPlant(
          request.resource.data
        ) &&
        request.resource.data.empresa_id ==
          resource.data.empresa_id &&
        request.resource.data.planta_id ==
          resource.data.planta_id &&
        request.resource.data.diff(
          resource.data
        ).affectedKeys().hasOnly([
          'estado_reproceso',
          'cantidad_reproceso_pendiente',
          'cantidad_resuelta_ok',
          'cantidad_resuelta_merma',
          'observacion_resolucion',
          'resuelto_por_id',
          'resuelto_por_nombre',
          'resuelto_en'
        ]);
      allow delete: if false;
    }

    match /{resumen}/{resumenId} {
      allow get: if resumen in [
          'resumenes_operario_dia',
          'resumenes_ot',
          'resumenes_ot_operacion',
          'resumenes_estandar_operacion',
          'resumenes_planta_turno'
        ] &&
        authenticated() &&
        (
          !exists(
            /databases/$(database)/documents/$(resumen)/$(resumenId)
          ) ||
          belongsToPlant(resource.data)
        );

      allow list: if resumen in [
          'resumenes_operario_dia',
          'resumenes_ot',
          'resumenes_ot_operacion',
          'resumenes_estandar_operacion',
          'resumenes_planta_turno'
        ] &&
        belongsToPlant(resource.data);

      allow create: if resumen in [
          'resumenes_operario_dia',
          'resumenes_ot',
          'resumenes_ot_operacion',
          'resumenes_estandar_operacion',
          'resumenes_planta_turno'
        ] &&
        canOperate() &&
        belongsToPlant(
          request.resource.data
        ) &&
        request.resource.data.actualizado_por_id ==
          request.auth.uid;

      allow update: if resumen in [
          'resumenes_operario_dia',
          'resumenes_ot',
          'resumenes_ot_operacion',
          'resumenes_estandar_operacion',
          'resumenes_planta_turno'
        ] &&
        canOperate() &&
        belongsToPlant(resource.data) &&
        belongsToPlant(
          request.resource.data
        ) &&
        request.resource.data.empresa_id ==
          resource.data.empresa_id &&
        request.resource.data.planta_id ==
          resource.data.planta_id &&
        request.resource.data.actualizado_por_id ==
          request.auth.uid;

      allow delete: if false;
    }

    match /{collectionName}/{documentId} {
      allow read: if authenticated() &&
        legacyCollection(collectionName);
      allow create, update: if canOperate() &&
        legacyCollection(collectionName);
      allow delete: if canManage() &&
        legacyCollection(collectionName);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
